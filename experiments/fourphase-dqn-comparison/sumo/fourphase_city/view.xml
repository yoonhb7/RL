<?xml version="1.0" encoding="UTF-8"?>
<viewsettings>
    <scheme name="Four phase city detailed">
        <background backgroundColor="232,239,226" showGrid="0"/>
        <edges laneEdgeMode="0" laneShowBorders="1" showLinkDecals="1"
               showLinkRules="1" hideConnectors="1" widthExaggeration="1">
            <colorScheme name="uniform">
                <entry color="57,69,80" name="road"/>
                <entry color="216,221,211" name="sidewalk"/>
                <entry color="170,95,75" name="bike lane"/>
                <entry color="0,0,0,0" name="green verge"/>
                <entry color="150,200,220" name="waterway"/>
                <entry color="80,80,80" name="no passenger"/>
                <entry color="220,70,70" name="closed"/>
                <entry color="100,150,100" name="connector"/>
            </colorScheme>
        </edges>
        <!-- The Python observer draws active vehicles using tracked polygons. -->
        <vehicles vehicleMode="0" vehicleQuality="2" vehicle_minSize="0"
                  vehicle_exaggeration="0.01" vehicle_constantSize="0" showBlinker="1"/>
        <junctions junctionMode="0" showLane2Lane="0" drawShape="1">
            <colorScheme name="uniform"><entry color="57,69,80"/></colorScheme>
        </junctions>
        <polys poly_minSize="0" poly_exaggeration="1" poly_constantSize="0" polyName_show="0"/>
    </scheme>
    <!-- SUMO selects the last loaded scheme: keep native cars visible standalone. -->
    <scheme name="Four phase city">
        <background backgroundColor="232,239,226" showGrid="0"/>
        <edges laneEdgeMode="0" laneShowBorders="1" showLinkDecals="1"
               showLinkRules="1" hideConnectors="1" widthExaggeration="1">
            <colorScheme name="uniform">
                <entry color="57,69,80" name="road"/>
                <entry color="216,221,211" name="sidewalk"/>
                <entry color="170,95,75" name="bike lane"/>
                <entry color="0,0,0,0" name="green verge"/>
                <entry color="150,200,220" name="waterway"/>
                <entry color="80,80,80" name="no passenger"/>
                <entry color="220,70,70" name="closed"/>
                <entry color="100,150,100" name="connector"/>
            </colorScheme>
        </edges>
        <vehicles vehicleMode="0" vehicleQuality="2" vehicle_minSize="1.5"
                  vehicle_exaggeration="1.25" vehicle_constantSize="0" showBlinker="1"/>
        <junctions junctionMode="0" showLane2Lane="0" drawShape="1">
            <colorScheme name="uniform"><entry color="57,69,80"/></colorScheme>
        </junctions>
        <polys poly_minSize="0" poly_exaggeration="1" poly_constantSize="0" polyName_show="0"/>
    </scheme>
    <viewport zoom="300" x="500" y="500"/>
    <delay value="100"/>
</viewsettings>
