  </time>
  <processing>
    <max-depart-delay value="-1" />
    <time-to-teleport value="-1" />
    <collision.action value="warn" />
    <collision.check-junctions value="true" />
  </processing>
  <random_number>
    <seed value="42" />
  </random_number>
  <gui_only>
    <gui-settings-file value="../../../view.xml" />
  </gui_only>
</configuration>