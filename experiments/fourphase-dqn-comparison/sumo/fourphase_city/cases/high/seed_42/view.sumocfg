<?xml version='1.0' encoding='utf-8'?>
<configuration>
  <input>
    <net-file value="../../../network.net.xml" />
    <route-files value="demand.rou.xml" />
    <additional-files value="../../../city.add.xml" />
  </input>
  <time>
    <begin value="0" />
    <end value="3600" />
