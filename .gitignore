# Local training/evaluation and private source data
/results/local/
/data/raw/

# Keep one demand file for opening the included SUMO configuration.
# All other explicit demand files are reproducibly generated by the code.
/sumo/*/demand/*
!/sumo/*/demand/seed_1001_scale_1.rou.xml

# Raw per-run outputs; small published summaries/models remain tracked.
*.log
tripinfo.xml
trace.csv
run.json
gui-screenshot.png

# PedLink published evidence is explicit; new local runs stay local.
/experiments/pedlink-dqn/results/view-*/
/experiments/pedlink-dqn/results/new-*/
/experiments/pedlink-dqn/results/evaluation-*/
/experiments/pedlink-dqn/results/experiment-*/
